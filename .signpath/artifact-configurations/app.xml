<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration d'artefact SignPath « app » : l'appli dépaquetée (dist/win-unpacked),
     envoyée en zip par actions/upload-artifact. Signe l'exécutable et les DLL. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="dev-brows.exe" />
      <include path="*.dll" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
