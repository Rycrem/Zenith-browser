<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration d'artefact SignPath « installer » : l'installateur NSIS, envoyé en zip. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="dev-brows-Setup-${version}.exe" product-name="dev-brows" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
